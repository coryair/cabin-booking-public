{
  "buildCommand": "bun run build:vercel",
  "installCommand": "bun install",
  "outputDirectory": "public",
  "framework": null,
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/send-round-reminders", "schedule": "0 14 * * *" },
    { "path": "/api/cron/send-reservation-reminders", "schedule": "0 15 * * *" },
    { "path": "/api/cron/send-invitation-reminders", "schedule": "0 16 */2 * *" },
    { "path": "/api/cron/cleanup-unpaid", "schedule": "0 6 * * *" }
  ]
}
