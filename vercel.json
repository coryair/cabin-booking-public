{
  "buildCommand": "bun run build:vercel",
  "installCommand": "bun install",
  "outputDirectory": "public",
  "framework": null,
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
